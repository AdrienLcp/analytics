{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [
                ":PACKAGE:",
                ":PACKAGE_WITH_PROTOCOL:",
                "!@/**",
                "!@analytics/**"
              ],
              ":BLANK_LINE:",
              "@analytics/protocol/**",
              ":BLANK_LINE:",
              [":ALIAS:", "@/**", "!@analytics/**"],
              ":BLANK_LINE:",
              [":PATH:", "@/**", "!@analytics/**"]
            ],
            "identifierOrder": "natural"
          }
        }
      }
    }
  },
  "extends": ["@adrienlcp/biome-config"],
  "files": {
    "includes": [
      "!.claude/skills",
      "!**/.wrangler",
      "!apps/api/public",
      "!apps/api/worker-configuration.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Date": "Read the time through infrastructure/clock.ts, parse or build a Date through infrastructure/dates.ts."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/dashboard/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["**/infrastructure/clock.ts", "**/infrastructure/dates.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
