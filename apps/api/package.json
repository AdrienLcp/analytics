{
  "dependencies": {
    "@adrienlcp/result": "^0.1.0",
    "@analytics/protocol": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.10",
    "isbot": "^5.2.2",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "vitest": "~5.0.2",
    "wrangler": "4.143.0"
  },
  "name": "@analytics/api",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler d1 migrations apply analytics --remote && wrangler deploy",
    "dev": "wrangler d1 migrations apply analytics --local && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
