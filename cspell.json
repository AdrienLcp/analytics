{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    "coverage",
    ".design",
    ".handoff",
    ".impeccable",
    ".playwright-mcp",
    "apps/api/public",
    "apps/api/worker-configuration.d.ts"
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": "**/i18n/dictionary-fr.ts",
      "language": "en,en-GB,fr"
    }
  ],
  "useGitignore": true,
  "version": "0.2",
