    "figcaption",
    "focusables",
    "Français",
    "Googlebot",
    "Grotesk",
    "ingilizce",
    "İngilizce",
    "isbot",
    "KHTML",
    "Lacourpaille",
    "lede",
    "ledes",
    "linecap",
    "linejoin",
    "linkedin",
    "minmax",
